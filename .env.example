# ─────────────────────────────────────────────────────────────────────────────
# Xanderia AI Council — environment. Copy to .env and edit.
# Secrets live here; everything else (personas, routing, departments) is in the DB.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security (CHANGE THESE) ──
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# First admin, created only when the users table is empty.
ADMIN_EMAIL=andrew@xanderia.com.my
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_DEPARTMENT=technology
# true when served over HTTPS (the default Caddy setup is HTTPS).
COOKIE_SECURE=true

# ── Model server (Ollama) ──
# aixan GPU server on the office LAN:
OLLAMA_BASE_URL=http://192.168.88.100:11434
# Ollama on the Docker host itself:           http://host.docker.internal:11434
# Ollama from `--profile ollama` in compose:  http://ollama:11434
# Remote GPU box behind hermes-proxy/tunnel:  https://hermes.example.com  (+ OLLAMA_API_KEY)
#
# Shared secret for an Ollama that sits behind hermes-proxy (sent as the header below).
# Leave empty for a plain LAN Ollama.
OLLAMA_API_KEY=
OLLAMA_API_KEY_HEADER=X-Hermes-Key
DEFAULT_CHAT_MODEL=hermes3:8b
DEFAULT_EMBED_MODEL=nomic-embed-text
# Must match OLLAMA_NUM_PARALLEL on the Ollama server (seeds providers.max_parallel;
# editable later in Admin → Models).
OLLAMA_NUM_PARALLEL=2

# ── Optional cloud provider (disabled by default; enable per role in Admin) ──
# CLOUD_API_KEY=

# ── Action Crew email (HANDOFF §14.4) ──
# Public URL staff use; the one-click links in task emails point here.
APP_BASE_URL=https://localhost
# outbox = record emails in Admin > Action Crew & email but never send (safe default)
# smtp   = send via SMTP_HOST/SMTP_USER/SMTP_PASS (Gmail Workspace or M365 SMTP relay)
# n8n    = POST each email to an n8n webhook, which sends it via your existing workflows
MAIL_PROVIDER=outbox
MAIL_FROM=Xanderia AI Council <council@xanderia.com.my>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# N8N_MAIL_WEBHOOK_URL=
# N8N_MAIL_SECRET=

# ── Web / proxy ──
# Hostname staff use. Caddy issues an internal-CA certificate for it.
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# ── Database / cache (compose wires the URLs; these are the credentials) ──
POSTGRES_USER=council
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=council

# ── Tuning ──
WORKER_CONCURRENCY=6
RATE_LIMIT_PER_MIN=20
LOG_LEVEL=info
